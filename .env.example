# Laravel API base URL (include /api if your routes are prefixed)
NEXT_PUBLIC_BASE_URL=https://api.thetravela.com/api

# Real payment gateway entry point (used when POST /orders does not return checkout_url)
NEXT_PUBLIC_PAYMENT_REDIRECT_URL=https://your-payment-provider.com/checkout

# Google Analytics 4 measurement ID (optional; defaults to G-E0NQKTR0BM)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-E0NQKTR0BM
